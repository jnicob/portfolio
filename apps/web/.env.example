# 'export' (default, estático) | 'node' (SSR + route handlers)
NEXT_OUTPUT_MODE=export
# URL pública del sitio (dominio oficial)
NEXT_PUBLIC_SITE_URL=https://jnicob.dev

# ──────────────────────────────────────────────────────────
# Formulario de Contacto
# ──────────────────────────────────────────────────────────
# Endpoint del script PHP de contacto. En producción apunta al PHP del hosting.
# En desarrollo local con NEXT_OUTPUT_MODE=node, apuntar al Route Handler:
#   NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact.php

# Variables del script PHP (se configuran en el panel del hosting, NO aquí):
#   CONTACT_TO=j.nico.b@gmail.com
#   CONTACT_FROM=no-reply@jnicob.dev
#   MAIL_TRANSPORT=mail (o smtp)
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS
