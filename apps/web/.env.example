# 'export' (default, estático) | 'node' (SSR + route handlers)
NEXT_OUTPUT_MODE=export
# URL pública del sitio (dominio oficial)
NEXT_PUBLIC_SITE_URL=https://jnicob.dev

# Configuración del formulario de contacto (envío real a j.nico.b@gmail.com)
CONTACT_DESTINATION_EMAIL=j.nico.b@gmail.com
# Servicio de entrega de email: Resend API Key (re_...) o Web3Forms Access Key
RESEND_API_KEY=
WEB3FORMS_KEY=
NEXT_PUBLIC_CONTACT_ENDPOINT=
