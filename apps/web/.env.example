# 'export' (default, static) | 'node' (SSR + route handlers)
NEXT_OUTPUT_MODE=export
# Public site URL (canonical domain)
NEXT_PUBLIC_SITE_URL=https://jnicob.dev

# ──────────────────────────────────────────────────────────
# Contact Form
# ──────────────────────────────────────────────────────────
# Contact PHP endpoint. In production, points to the hosting PHP script.
# In local dev with NEXT_OUTPUT_MODE=node, point to the Route Handler:
#   NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact.php

# PHP script environment variables (configured in hosting panel, NOT here):
#   CONTACT_TO=contact@example.com
#   CONTACT_FROM=no-reply@jnicob.dev
#   MAIL_TRANSPORT=mail (or smtp)
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS

# ──────────────────────────────────────────────────────────
# Private CV Contact (LOCAL ONLY / .env.local)
# ──────────────────────────────────────────────────────────
# Read only during the private pass of `pnpm run cv:pdf`, or in `pnpm run dev`
# when CV_INCLUDE_PRIVATE=true is explicitly enabled.
# Never bundled into `pnpm run build` or committed to Git.
# CV_INCLUDE_PRIVATE=true
# CV_EMAIL=contact@example.com
# CV_PHONE=+34 600 000 000
